COLUMN TABLE "MDT_T_TSTRS" ("TSRID" BIGINT CS_FIXED GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Unique id/TestResult Id', "EPLID" BIGINT CS_FIXED COMMENT 'Employee Record Unique Id', "TGRUP" INTEGER CS_INT COMMENT 'Test Group', "TCODE" INTEGER CS_INT COMMENT 'Test Code', "STTUS" INTEGER CS_INT COMMENT 'Test Status', "TSTRT" INTEGER CS_INT COMMENT 'Test Result', "MDLTP" INTEGER CS_INT COMMENT 'Model type', "TTYPE" INTEGER CS_INT COMMENT 'Test Type', "RCFRQ" INTEGER CS_INT COMMENT 'Recall Frequency', "TTDDT" DATE CS_DAYDATE COMMENT 'Test Due Date', "DTCMT" DATE CS_DAYDATE COMMENT 'Date Completed', "PRVDR" NVARCHAR(1000) COMMENT 'Provider', "NMRST" NVARCHAR(50) COMMENT 'Numeric Results', "COMNT" NVARCHAR(5000) COMMENT 'Comments', "ISEML" SMALLINT CS_INT COMMENT 'Email send to emplyee - Flag', "ISROW" SMALLINT CS_INT COMMENT '0 Is Row OR 1 is wrps', "RNFDL" NVARCHAR(5000) COMMENT 'Reason For Deletion', "SUBDT" DATE CS_DAYDATE COMMENT 'Submitted Date', "SUBTM" TIME CS_SECONDTIME COMMENT 'Submitted Time', "ISDEL" NVARCHAR(1) COMMENT 'Is Deleted Flag (1=True/0=False)', "CRTBY" NVARCHAR(40) COMMENT 'Created By', "CRTDT" DATE CS_DAYDATE COMMENT 'Created Date', "CRTTM" TIME CS_SECONDTIME COMMENT 'Created Time', "CHNBY" NVARCHAR(40) COMMENT 'Changed By', "CHNDT" DATE CS_DAYDATE COMMENT 'Changed Date', "CHNTM" TIME CS_SECONDTIME COMMENT 'Changed Time', "EMPID" NVARCHAR(40) COMMENT 'Employee ID', "USRID" NVARCHAR(40) COMMENT 'User ID', "RFNRQ" NVARCHAR(5000) COMMENT 'Reason For Not Required', PRIMARY KEY ("TSRID")) UNLOAD PRIORITY 5  AUTO MERGE
;
